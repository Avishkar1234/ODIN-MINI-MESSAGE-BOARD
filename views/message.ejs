<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <title>Message Details</title>
  </head>
  <body>
    <h1>Mini Messageboard</h1>
    <h1>Message Details</h1>

    <p><strong>User:</strong> <%= message.user_name %></p>
    <p><strong>Message:</strong> <%= message.text %></p>
    <p><strong>Posted:</strong> <%= message.added.toLocaleString() %></p>

    <a href="/">Back to all messages</a>
  </body>
</html>
