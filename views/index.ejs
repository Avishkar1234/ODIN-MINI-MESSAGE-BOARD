<!DOCTYPE html>
<html>
  <head>
    <title>Mini Messageboard</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <h1><%= title %></h1>

    <a href="/new">New Message</a>

    <ul>
      <% messages.forEach((message, index) => { %>
        <li>
          <strong><%= message.user_name %></strong>: <%= message.text %>
          <br>
          <small><%= message.added.toLocaleString() %></small>
          <br>
          <a href="/message/<%= message.id %>">Open</a>
        </li>
      <% }) %>
    </ul>
  </body>
</html>
