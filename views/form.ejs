<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Message</title>
</head>
<body>
    <h1>Mini Messageboard</h1>
    <h1>New Message</h1>

    <form method="POST" action="/new">
        <div>
            <label>Name:</label>
            <input name="messageUser" required>
        </div>
        <div>
            <label>Message:</label>
            <input name="messageText" required>
        </div>

        <button type="submit">Send</button>
    </form>

    <a href="/">Back</a>
</body>
</html>